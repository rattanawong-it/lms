# ─────────── App ───────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────── Database ───────────
DATABASE_URL=postgresql://lms:lms@localhost:5436/lms

# ─────────── Better Auth ───────────
# สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────── Storage (S3-compatible) — ใช้จริงใน Phase 1 ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lms
S3_ACCESS_KEY_ID=lmsadmin
S3_SECRET_ACCESS_KEY=lmsadmin123
# MinIO ต้องใช้ path-style · Cloudflare R2 ให้ตั้งเป็น false (D-01)
S3_FORCE_PATH_STYLE=true

# ─────────── Email ───────────
EMAIL_PROVIDER=smtp            # smtp | resend
SMTP_URL=smtp://localhost:1026
RESEND_API_KEY=
EMAIL_FROM="KRIRK LMS <no-reply@krirk.ac.th>"

# ─────────── LINE — Phase 3 (M12) ───────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_BASIC_ID=               # เช่น @krirklms — ลิงก์เพิ่มเพื่อนในหน้า /settings/line
# LINE_API_URL=https://api.line.me  # ทดสอบ e2e โดยไม่ยิง LINE จริง: ชี้ไปพอร์ตที่ไม่มีบริการ เช่น http://127.0.0.1:9

# ─────────── Jobs ───────────
CRON_SECRET=

# ─────────── Seed (prisma db seed) ───────────
# บัญชี Super Admin ตั้งต้น — เปลี่ยนรหัสผ่านทันทีหลัง login ครั้งแรก
SEED_ADMIN_EMAIL=admin@krirk.ac.th
SEED_ADMIN_PASSWORD=
